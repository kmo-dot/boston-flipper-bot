# Copy to .env and adjust as needed. All of these have sane defaults in
# boston_flipper/config.py -- you only need this file to override them.

# Hard filters
BFB_MAX_PRICE=50
BFB_MAX_AGE_HOURS=24
BFB_MAX_DISTANCE_MILES=15

# Craigslist
BFB_CL_SUBDOMAIN=boston

# Facebook Marketplace
BFB_FB_STORAGE_STATE=data/sessions/facebook_storage_state.json
BFB_FB_LOCATION_SLUG=boston

# Nextdoor (manual-paste fallback -- see boston_flipper/sources/nextdoor.py)
BFB_ND_MANUAL_INBOX=data/nextdoor_manual_inbox.md

# Output
BFB_OUTPUT_DIR=output
